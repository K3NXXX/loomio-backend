		"seed:engage": "ts-node prisma/seed-synthetic-engagement.ts",
		"seed:gaming-demo": "ts-node prisma/seed-gaming-demo.ts",
		"stripe:listen": "stripe listen --forward-to localhost:4000/payments/webhook"
	},
	"prisma": {
		"seed": "ts-node prisma/seed.ts"
	},
