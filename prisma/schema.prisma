generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  name     String?  @db.VarChar(255)
  username String  @unique @db.VarChar(39)
  email    String  @unique @db.VarChar(255)
  providerEmail String? @map("provider_email") @db.VarChar(255)
  password String? @db.VarChar(255)
  isPremium Boolean @default(false)
  avatarUrl      String? @map("avatar_url")
  avatarPublicId String? @map("avatar_public_id")

  role     UserRole @default(USER)
  bio      String?  @db.Text
  isActive Boolean  @default(true) @map("is_active")

  theme ThemeColors @default(BLUE)
  locale Locale @default(UK)

  accounts Account[]
  sessions Session[]
  channels Channel[]
  reports  Report[]

  VideoLike        VideoLike[]
  VideoView        VideoView[]
  VideoComment     VideoComment[]
  VideoCommentLike VideoCommentReaction[]
  ChannelFollow    ChannelFollow[]

  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  playlists             Playlist[]
  notificationsReceived Notification[] @relation("NotificationReceiver")
  notificationsAuthored Notification[] @relation("NotificationAuthor")

  assignedReports Report[] @relation("ReportAssignedTo")

  @@index([email])
  @@index([username])
  @@index([isActive])
  @@index([role])
  @@map("users")
}

model Channel {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(50)
  username    String  @unique @db.VarChar(20)
  description String? @db.Text

  avatarUrl      String? @map("avatar_url")
  avatarPublicId String? @map("avatar_public_id")

  bannerUrl      String? @map("banner_url")
  bannerPublicId String? @map("banner_public_id")

  isDefault Boolean @default(false) @map("is_default")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videos    Video[]
  followers ChannelFollow[]

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  playlists     Playlist[]
  notifications Notification[] @relation("NotificationToChannel")

  @@index([userId])
  @@map("channels")
}

model ChannelFollow {
  id         String @id @default(uuid())
  follower   User   @relation(fields: [followerId], references: [id], onDelete: Cascade)
  followerId String

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  notificationsEnabled Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([followerId, channelId])
  @@index([channelId])
  @@map("channel_follows")
}

model Video {
  id            String      @id @default(uuid())
  title         String      @db.VarChar(200)
  description   String?     @db.Text
  tags          String?     @db.VarChar(500)
  visibility    Visibility
  /// Snapshot from moderator action when visibility becomes restricted (fallback: latest resolved report)
  restrictionModeratorReason ReportReason? @map("restriction_moderator_reason")
  restrictionModeratorNote   String?       @map("restriction_moderator_note") @db.Text

  audience      Audience
  publishType   PublishType
  publishDate   DateTime?
  videoFile     String      @db.VarChar(255)
  thumbnailFile String      @db.VarChar(255)

  videoPublicId     String? @db.VarChar(255)
  thumbnailPublicId String? @db.VarChar(255)

  channelId String  @map("channel_id")
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  likesCount    Int @default(0) @map("likes_count")
  dislikesCount Int @default(0) @map("dislikes_count")

  likes    VideoLike[]
  views    VideoView[]
  comments VideoComment[]

  notifications Notification[] @relation("NotificationToVideo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlists Playlist[] @relation("PlaylistVideos")
  reports   Report[]

  @@index([channelId])
  @@index([visibility])
  @@index([publishType])
  @@map("videos")
}

model VideoLike {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId String

  isLike    Boolean @default(false) @map("is_like")
  isDislike Boolean @default(false) @map("is_dislike")

  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([videoId])
  @@map("video_likes")
}

model VideoView {
  id      String @id @default(uuid())
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId String

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  ip        String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now())

  @@index([videoId])
  @@index([userId])
  @@map("video_views")
}

model VideoComment {
  id      String @id @default(uuid())
  content String @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId String

  parent   VideoComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  VideoComment[] @relation("CommentReplies")

  reactions VideoCommentReaction[]

  likesCount    Int @default(0) @map("likes_count")
  dislikesCount Int @default(0) @map("dislikes_count")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[] @relation("NotificationToComment")
  reports       Report[]

  @@index([videoId])
  @@index([userId])
  @@map("video_comments")
}

model VideoCommentReaction {
  id        String       @id @default(uuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  comment   VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("video_comment_reactions")
}

model Account {
  id         String @id @default(uuid())
  provider   String
  providerId String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([provider, providerId])
  @@map("accounts")
}

model Playlist {
  id          String  @id @default(uuid())
  name        String
  description String?
  coverUrl      String?
  coverPublicId String?

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id])

  videos Video[] @relation("PlaylistVideos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videoId   String?
}

model Token {
  id        String    @id @default(uuid())
  email     String
  code      String
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  meta      Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, type])
  @@unique([code, type])
  @@index([email, type])
  @@index([code, type])
  @@map("tokens")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String           @db.VarChar(500)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  videoId String? @map("video_id")
  video   Video?  @relation("NotificationToVideo", fields: [videoId], references: [id], onDelete: Cascade)

  channelId String?  @map("channel_id")
  channel   Channel? @relation("NotificationToChannel", fields: [channelId], references: [id], onDelete: Cascade)

  commentId String?       @map("comment_id")
  comment   VideoComment? @relation("NotificationToComment", fields: [commentId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([authorId])
  @@index([videoId])
  @@index([channelId])
  @@index([commentId])
  @@map("notifications")
}

model Report {
  id        String       @id @default(uuid())
  reason    ReportReason
  message   String?      @db.Text
  createdAt DateTime     @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  commentId String?
  comment   VideoComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  status ReportStatus @default(PENDING)

  assignedToId String?
  assignedTo   User?   @relation("ReportAssignedTo", fields: [assignedToId], references: [id])

  /// Reason recorded when a moderator restricts the video (may differ from reporter `reason`)
  moderatorRestrictionReason ReportReason? @map("moderator_restriction_reason")
  moderatorNote              String?       @map("moderator_note") @db.Text

  @@index([videoId])
  @@index([commentId])
  @@index([authorId])
  @@map("reports")
}

model Session {
  id        String    @id @default(uuid())
  token     String    @unique
  ip        String
  userAgent String?   @map("user_agent")
  revoked   Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([ip, userAgent, revoked, expiresAt])
  @@map("sessions")
}

enum Visibility {
  public
  private
  restricted
  /// Owner resubmitted corrected video; awaiting moderator decision (not publicly visible)
  pending_review
}

enum Audience {
  yes
  no
}

enum PublishType {
  now
  scheduled
}

enum UserRole {
  USER
  ADMIN
}

enum TokenType {
  VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum ThemeColors {
  RED
  ORANGE
  GREEN
  BLUE
  YELLOW
  VIOLET
  WHITE
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum NotificationType {
  VIDEO_PUBLISHED
  CHANNEL_NEW_FOLLOWER
  COMMENT_NEW
  COMMENT_REPLY
  LIKE_VIDEO
  DISLIKE_VIDEO
  LIKE_COMMENT
  COMMENT_REMOVED
  VIDEO_RESTRICTED
  VIDEO_APPROVED
}

enum ReportReason {
  HATE_SPEECH
  HARASSMENT
  SPAM
  SEXUAL_CONTENT
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum Locale {
  UK
  EN
}
